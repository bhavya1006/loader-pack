{
  "name": "loader-pack",
  "version": "1.1.2",
  "description": "A beautiful animated intro/loader screen for React apps",
  "type": "module",
  "main": "dist/loader-pack.umd.cjs",
  "module": "dist/loader-pack.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/loader-pack.js",
      "require": "./dist/loader-pack.umd.cjs"
    },
    "./styles": "./dist/loader-pack.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.0.0-beta.6"
  },
  "keywords": [
    "react",
    "loader",
    "intro-screen",
    "animation",
    "portfolio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhavya1006/loader-pack"
  }
}
